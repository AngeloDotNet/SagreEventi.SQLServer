{
    "Kestrel": {
        "Limits": {
            "MaxRequestBodySize": 5242880
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning"
        }
    },
    "ConnectionStrings": {
        "Default": "Data Source=[HOSTNAME];Initial Catalog=SagreEventi;User ID=[USERNAME];Password=[PASSWORD];Encrypt=False" //Hosted
        //"Default": "server=[HOSTNAME-DOCKER-DATABASE];database=sagreeventi;user=[USERNAME];password=[PASSWORD];encrypt=false" //Docker
    },
    "Eventi": {
        "MaxPerRichiesta": 20,
        "RichiestePutAlMinuto": 10,
        "RichiesteStatiAlMinuto": 30,
        "RichiesteChallengeAlMinuto": 30
    },
    "Altcha": {
        // Anti-bot proof of work. FITTIZIA: la chiave reale va in Altcha__HmacKey (variabile d'ambiente), mai qui
        "HmacKey": "CHANGE-ME-placeholder-not-a-real-key-0000",
        "MaxNumber": 300000,
        "ChallengeValidityMinutes": 10
    },
    "Database": {
        "MigraAllAvvio": true
    },
    "Identity": {
        // Utenti creati al primo avvio con dati FITTIZI: cambiali in appsettings.local.json (non versionato)
        "Admin": {
            "Email": "admin@sagreeventi.local",
            "Password": "Admin!12345"
        },
        "Editor": {
            "Email": "editor@sagreeventi.local",
            "Password": "Editor!12345"
        }
    },
    "Cors": {
        "Origins": [ "http://localhost:4200" ]
    },
    "AllowedHosts": "*"
}