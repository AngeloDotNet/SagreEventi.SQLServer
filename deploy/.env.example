# Copy to .env (not versioned) next to the docker-compose files and fill in.

# ==========================================================
# DOCKER HUB (both compose files: image name <user>/sagreeventi-api|web)
# ==========================================================
# docker-compose.yml defaults to angelo87dock when it is left unset
DOCKERHUB_USERNAME=angelo87dock

# ==========================================================
# ANGULAR (docker-compose.angular.yml)
# ==========================================================
# No variables: the image does not read any environment.
# Runtime settings live in public/config.json (apiBaseUrl is empty = same origin, /api is proxied by the container nginx).

# ==========================================================
# API .NET (docker-compose.server.yml, read through env_file)
# ==========================================================
# Same hostname published by the host nginx
AllowedHosts=myhost.mydomain.ext

# SQL Server reachable from docker-net
ConnectionStrings__Default=Server=[HOSTNAME-DOCKER-DATABASE];Database=SagreEventi;User Id=[USERNAME];Password=[PASSWORD];Encrypt=True;TrustServerCertificate=True

# Apply the migrations at startup
Database__MigraAllAvvio=true

# Users created at first start
Identity__Admin__Email=admin@example.com
Identity__Admin__Password=ChangeMe!Admin123
# Optional Editor user (leave empty to skip it)
Identity__Editor__Email=
Identity__Editor__Password=

# Same origin behind nginx: no CORS origins
Cors__Origins__0=

# X-Forwarded-For / X-Forwarded-Proto are trusted only from this subnet.
# docker-compose.yml (single file): also the subnet it creates for its own network, pick one that is free on the host
# The two separate compose files: subnet of docker-net (docker network inspect docker-net)
ForwardedHeaders__KnownNetworks__0=172.29.250.0/24
