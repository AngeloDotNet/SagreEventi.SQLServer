# Copy to .env (not versioned) and fill in. Used by docker-compose.yml.
SERVER_NAME=localhost
SQL_SA_PASSWORD=ChangeMe!Str0ngPassw0rd
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!Admin123
# Optional Editor user
EDITOR_EMAIL=
EDITOR_PASSWORD=
# Optional published ports (default 80 / 443)
HTTP_PORT=80
HTTPS_PORT=443

# Self-signed certificate for a trial (put the files in deploy/certs/):
#   openssl req -x509 -nodes -newkey rsa:2048 -days 365 -keyout deploy/certs/privkey.pem -out deploy/certs/fullchain.pem -subj "/CN=localhost"
