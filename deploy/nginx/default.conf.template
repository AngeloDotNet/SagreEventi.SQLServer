# Reverse proxy of SagreEventi: nginx terminates HTTPS, the API and the web container only speak plain HTTP on the internal network.

# Rate limit layer 1 (coarse, per IP); the API applies its own finer limits (login, PUT, GetStati)
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

# Internal health check of the proxy container (not routed to the outside)
server {
    listen 8080 default_server;
    server_name _;

    location = /healthz-proxy {
        access_log off;
        return 200 "ok";
    }

    # HTTP: only a redirect to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;

    # Aligned with Kestrel's MaxRequestBodySize (5 MB): bigger bodies are rejected here with 413 before reaching the API
    client_max_body_size 5m;

    # HSTS also on the static files (the API sends it for /api by itself, from the forwarded scheme)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # API: same origin as the frontend, so no CORS in production
    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;

        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        # $remote_addr (not $proxy_add_x_forwarded_for): a client-sent X-Forwarded-For is never passed on, the API sees only the real address
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 30s;
    }

    # Frontend
    location / {
        proxy_pass http://web:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
    }
}
